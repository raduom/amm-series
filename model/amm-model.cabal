cabal-version: 3.0
name:          amm-model
version:       0.1.0.0
synopsis:      Readable Haskell models of automated market makers
license:       NONE
build-type:    Simple

common warnings
  ghc-options: -Wall

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    , AMM.ConstantProduct
    , AMM.ConstantSum
  build-depends:    base ^>=4.22
  default-language: GHC2024

test-suite properties
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    , AMM.ConstantProductProperties
    , AMM.ConstantSumProperties
    , AMM.MarketPriceProperties
  build-depends:
    , amm-model
    , base              ^>=4.22
    , QuickCheck        ^>=2.19
    , tasty             ^>=1.5.5
    , tasty-quickcheck  ^>=0.11.1
  default-language: GHC2024
